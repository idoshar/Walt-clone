# Copy this file to .env before running the mobile app.
# Do not commit the local .env file.

# Expo Go on a physical phone:
# Replace YOUR_COMPUTER_LAN_IP with this computer's IPv4 address.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:3000/api

# Android Emulator alternative:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api

# Expo Web on the same computer alternative:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
