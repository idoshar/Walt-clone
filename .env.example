# Exercise 5 environment configuration example
# Copy this file to .env for local development if needed.

# Host port exposed for the NodeJS/Express web server
WEB_SERVER_HOST_PORT=3000

# Internal port used by the NodeJS/Express web server inside Docker
WEB_SERVER_PORT=3000

# Internal port used by the C++ recommendation server inside Docker
EX2_SERVER_PORT=8080

# Docker service name of the C++ recommendation server
EX2_HOST=ex2-server

# API base URL for the React client during local development
VITE_API_BASE_URL=http://localhost:3000/api

# MongoDB database name used by the Docker Compose environment
MONGODB_DB_NAME=food_delivery

# MongoDB connection string used by the web-server container
MONGODB_URI=mongodb://mongo:27017/food_delivery
# Optional initial admin bootstrap.
# Leave all values empty to disable bootstrap.
# When configured, all five values below are required.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_ADDRESS=
