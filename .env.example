# Exercise 4 environment configuration example
# Copy this file to .env for local development if needed.

# Host port exposed for the NodeJS/Express web server
WEB_SERVER_HOST_PORT=3000

# Internal port used by the NodeJS/Express web server inside Docker
WEB_SERVER_PORT=3000

# Internal port used by the C++ recommendation server inside Docker
EX2_SERVER_PORT=8080

# Docker service name of the C++ recommendation server
EX2_HOST=ex2-server

# API base URL for the React client during local development
VITE_API_BASE_URL=http://localhost:3000/api
